{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CosmosDb": {
    "AccountEndpoint": "YOUR_COSMOS_ENDPOINT",
    "AccountKey": "YOUR_COSMOS_KEY",
    "DatabaseName": "CatFoodManager",
    "ContainerName": "MainContainer"
  },
  "Jwt": {
    "Secret": "YOUR_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "CatFoodManager",
    "Audience": "CatFoodManagerApp",
    "ExpirationDays": 30
  }
}
